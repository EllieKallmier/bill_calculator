          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"3-battery-configuration\">3. Battery Configuration</h2>\n<span class=\"paragraph\">Optionally add a battery to the scenario. The battery uses a simple\nalgorithm to maximise self-consumption of solar PV generation.</span></span>"
          }
        }
      ],
      "console": []
    },
    {
